<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local Maven settings for building this Flink fork against Apache snapshot
  artifacts (e.g. the in-development 2.x-SNAPSHOT modules this branch depends on).
  The Flink POMs do not declare the Apache snapshots repository, so pass this
  file explicitly:

      ./mvnw -s settings.xml -pl flink-formats/flink-parquet test

  It only adds a repository; no mirrors or credentials.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <profiles>
    <profile>
      <id>apache-snapshots</id>
      <repositories>
        <repository>
          <id>apache.snapshots</id>
          <url>https://repository.apache.org/content/repositories/snapshots/</url>
          <releases><enabled>false</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>apache.snapshots.plugins</id>
          <url>https://repository.apache.org/content/repositories/snapshots/</url>
          <releases><enabled>false</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>apache-snapshots</activeProfile>
  </activeProfiles>
</settings>
